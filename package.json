{
  "name": "leao",
  "version": "0.1.0",
  "description": "Leão: painel local para comandar as sessões do Claude Code — estado, consumo, entregas, chat com perguntas e permissões.",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node server/index.js",
