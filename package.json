    "marked": "^15.0.12",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^24.1.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
